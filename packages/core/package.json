{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "1.18.3",
  "name": "@opencora/core",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "db": "bun drizzle-kit",
    "migration": "bun run script/migration.ts",
    "fix-node-pty": "bun run script/fix-node-pty.ts",
    "test": "bun test --only-failures",
    "typecheck": "tsgo --noEmit"
  },
  "bin": {
    "opencode": "./bin/opencode"
  },
  "exports": {
    "./effect/layer-node": "./src/effect/layer-node.ts",
    "./effect/app-node": "./src/effect/app-node.ts",
    "./session/runner": "./src/session/runner/index.ts",
    "./system-context": "./src/system-context/index.ts",
    "./*": "./src/*.ts"
  },
  "imports": {
    "#sqlite": {
      "bun": "./src/database/sqlite.bun.ts",
      "node": "./src/database/sqlite.node.ts",
      "default": "./src/database/sqlite.bun.ts"
    },
    "#pty": {
      "bun": "./src/pty/pty.bun.ts",
      "node": "./src/pty/pty.node.ts",
      "default": "./src/pty/pty.bun.ts"
    },
    "#fff": {
      "bun": "./src/filesystem/fff.bun.ts",
      "node": "./src/filesystem/fff.node.ts",
      "default": "./src/filesystem/fff.bun.ts"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.12.2",
    "@types/npm-package-arg": "6.1.4",
    "@types/npmcli__arborist": "6.3.3",
    "@types/semver": "7.7.1",
    "@types/turndown": "5.0.5",
    "@types/which": "3.0.4",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1",
    "drizzle-kit": "1.0.0-rc.2",
    "@opencora/http-recorder": "workspace:*"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.41",
    "@ai-sdk/provider": "3.0.8",
    "@ai-sdk/provider-utils": "4.0.23",
    "@effect/platform-node": "4.0.0-beta.83",
    "@effect/sql-sqlite-bun": "4.0.0-beta.83",
    "@lydell/node-pty": "1.2.0-beta.12",
    "@ff-labs/fff-bun": "0.9.4",
    "@npmcli/arborist": "9.4.0",
    "@npmcli/config": "10.8.1",
    "@parcel/watcher": "2.5.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@openrouter/ai-sdk-provider": "2.9.0",
    "bun-pty": "0.4.8",
    "cross-spawn": "7.0.6",
    "diff": "8.0.2",
    "drizzle-orm": "1.0.0-rc.2",
    "effect": "4.0.0-beta.83",
    "fuzzysort": "3.1.0",
    "glob": "13.0.5",
    "gray-matter": "4.0.3",
    "htmlparser2": "8.0.2",
    "immer": "11.1.4",
    "ignore": "7.0.5",
    "jsonc-parser": "3.3.1",
    "mime-types": "3.0.2",
    "minimatch": "10.2.5",
    "npm-package-arg": "13.0.2",
    "semver": "^7.6.3",
    "turndown": "7.2.0",
    "which": "6.0.1",
    "xdg-basedir": "5.1.0",
    "zod": "4.1.8",
    "@opencora/effect-drizzle-sqlite": "workspace:*",
    "@opencora/effect-sqlite-node": "workspace:*",
    "@opencora/llm": "workspace:*",
    "@opencora/schema": "workspace:*",
    "@opencora/plugin": "workspace:*"
  },
  "overrides": {
    "drizzle-orm": "catalog:"
  }
}